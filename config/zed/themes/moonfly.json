{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Moonfly",
  "author": "You (ported by ChatGPT)",
  "themes": [
    {
      "name": "Moonfly",
      "appearance": "dark",
      "style": {
        "accents": [
          "#80a0ff",
          "#79dac8",
          "#8cc85f",
          "#e3c78a",
          "#ae81ff",
          "#cf87e8",
          "#de935f",
          "#e65e72"
        ],

        "background": "#080808",
        "border": "#2a2a2a",
        "border.variant": "#1a1a1a",
        "border.focused": "#80a0ff",
        "border.selected": "#79dac8",

        "element.background": "#111111",
        "element.hover": "#161616",
        "element.active": "#1c1c1c",
        "element.selected": "#1b1f2a",
        "ghost_element.background": "#080808",
        "ghost_element.hover": "#101010",
        "ghost_element.active": "#151515",
        "elevated_surface.background": "#0f0f0f",

        "text": "#bdbdbd",
        "text.muted": "#8a8a8a",
        "text.placeholder": "#6f6f6f",
        "text.accent": "#80a0ff",
        "icon": "#bdbdbd",
        "icon.muted": "#8a8a8a",
        "icon.accent": "#79dac8",

        "editor.background": "#080808",
        "editor.foreground": "#bdbdbd",
        "editor.gutter.background": "#080808",
        "editor.line_number": "#5f5f5f",
        "editor.active_line_number": "#bdbdbd",
        "editor.active_line.background": "#101010",
        "editor.highlighted_line.background": "#101010",
        "editor.invisible": "#2a2a2a",
        "editor.indent_guide": "#1a1a1a",
        "editor.indent_guide_active": "#2a2a2a",
        "editor.wrap_guide": "#1a1a1a",

        "editor.document_highlight.read_background": "#151515",
        "editor.document_highlight.write_background": "#1b1f2a",
        "editor.document_highlight.bracket_background": "#1b1f2a",

        "created": "#8cc85f",
        "modified": "#e3c78a",
        "deleted": "#ff5d5d",
        "conflict": "#e65e72",
        "error": "#ff5d5d",
        "warning": "#e3c78a",
        "success": "#8cc85f",
        "hint": "#79dac8",

        "terminal.background": "#080808",
        "terminal.foreground": "#bdbdbd",
        "terminal.ansi.black": "#080808",
        "terminal.ansi.red": "#ff5d5d",
        "terminal.ansi.green": "#8cc85f",
        "terminal.ansi.yellow": "#e3c78a",
        "terminal.ansi.blue": "#80a0ff",
        "terminal.ansi.magenta": "#ae81ff",
        "terminal.ansi.cyan": "#79dac8",
        "terminal.ansi.white": "#bdbdbd",
        "terminal.ansi.bright_black": "#3a3a3a",
        "terminal.ansi.bright_red": "#ff5d5d",
        "terminal.ansi.bright_green": "#8cc85f",
        "terminal.ansi.bright_yellow": "#e3c78a",
        "terminal.ansi.bright_blue": "#74b2ff",
        "terminal.ansi.bright_magenta": "#cf87e8",
        "terminal.ansi.bright_cyan": "#36c692",
        "terminal.ansi.bright_white": "#e6e6e6",

        "syntax": {
          "comment": { "color": "#6f6f6f", "font_style": "italic" },
          "comment.doc": { "color": "#7a7a7a", "font_style": "italic" },

          "string": { "color": "#c6c684" },
          "string.special": { "color": "#ae81ff" },
          "character.escape": { "color": "#e65e72" },

          "number": { "color": "#de935f" },
          "constant": { "color": "#de935f" },
          "boolean": { "color": "#de935f" },

          "keyword": { "color": "#cf87e8", "font_weight": 600 },
          "operator": { "color": "#e65e72" },

          "function": { "color": "#74b2ff" },
          "function.method": { "color": "#74b2ff" },
          "constructor": { "color": "#36c692" },

          "type": { "color": "#36c692" },
          "type.builtin": { "color": "#36c692" },

          "property": { "color": "#adadf3" },
          "attribute": { "color": "#79dac8" },

          "variable": { "color": "#bdbdbd" },
          "variable.parameter": { "color": "#e196a2" },

          "punctuation": { "color": "#e65e72" },
          "punctuation.bracket": { "color": "#8a8a8a" },
          "punctuation.delimiter": { "color": "#8a8a8a" },

          "tag": { "color": "#80a0ff" },
          "label": { "color": "#79dac8" }
        }
      }
    }
  ]
}

